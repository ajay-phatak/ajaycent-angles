	  chart this stagger runs at every width: TARP/Recovery Act sit ten weeks
	  apart on a 34-year axis, so they collide even on desktop.
	*/
	function computeEventRows(ch) {
		const { scales } = ch;
		let prevX = null;
		let prevRow = 0;
		let maxRow = 0;
		const rows = events.map((e) => {
			const x = scales.x.getPixelForValue(e.x);
			const row = prevX !== null && Math.abs(x - prevX) < 24 ? prevRow + 1 : 0;
			prevX = x;
			prevRow = row;
			maxRow = Math.max(maxRow, row);
			return row;
		});
		return { rows, maxRow };
	}

	function monthYear(x) {
		const year = Math.floor(x);
		const month = Math.min(11, Math.round((x - year) * 12));
		const names = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
		return `${names[month]} ${year}`;
	}

	function render() {
		const canvas = document.getElementById('debt-chart');
		if (!canvas) return;
		const c = palette();
		const party = partyColors(c.dark);
		const narrow = NARROW();
		Chart.getChart(canvas)?.destroy();

		const overlay = {
			id: 'debtOverlay',
			beforeDatasetsDraw(ch) {
				const { ctx, chartArea: a, scales } = ch;
				if (!a) return;
				ctx.save();

				terms.forEach((t) => {
					const x0 = Math.max(a.left, scales.x.getPixelForValue(t.from));
					const x1 = Math.min(a.right, scales.x.getPixelForValue(t.to));
					ctx.fillStyle = party[t.party];
					ctx.fillRect(x0, a.top, x1 - x0, a.bottom - a.top);

					if (!t.name) return;
					const nameColor = t.party === 'd' ? party.dName : party.rName;
					ctx.font = `italic ${narrow ? 9.5 : 11}px ${c.serif}`;
					ctx.textAlign = 'center';
					ctx.textBaseline = 'bottom';
					const width = x1 - x0;
					let text = t.name;
					if (ctx.measureText(text).width > width - 6) {
						text = t.name[0];
						if (ctx.measureText(text).width > width - 4) return;
					}
					ctx.fillStyle = nameColor;
					ctx.fillText(text, (x0 + x1) / 2, a.top - 4);
				});

				// Reference line where debt crosses 100% of GDP (2013)
				const y100 = scales.yR.getPixelForValue(100);
				ctx.setLineDash([5, 4]);
				ctx.lineWidth = 1;
				ctx.strokeStyle = c.warmFaint;
				ctx.beginPath();
				ctx.moveTo(a.left, y100);
				ctx.lineTo(a.right, y100);
				ctx.stroke();
				ctx.setLineDash([]);
				ctx.font = `italic ${narrow ? 9 : 10.5}px ${c.serif}`;
				ctx.fillStyle = c.warm;
				ctx.textAlign = 'left';
				ctx.textBaseline = 'bottom';
				ctx.fillText('Debt = 100% of GDP', a.left + 7, y100 - 3);

				ctx.restore();
			},
			afterDraw(ch) {
				const { ctx, chartArea: a, scales } = ch;
				if (!a) return;
				ctx.save();

				const bubbleR = narrow ? 7 : 8;
				const numFont = narrow ? 8.5 : 10;
				const { rows } = computeEventRows(ch);

				events.forEach((e, i) => {
					const x = scales.x.getPixelForValue(e.x);
					const cy = a.top + 8 + rows[i] * 19;
					ctx.setLineDash([3, 4]);
					ctx.lineWidth = 1;
					ctx.strokeStyle = c.inkSoft;
					ctx.beginPath();
					ctx.moveTo(x, cy + bubbleR + 2);
					ctx.lineTo(x, a.bottom);
					ctx.stroke();
					ctx.setLineDash([]);
					ctx.beginPath();
					ctx.arc(x, cy, bubbleR, 0, Math.PI * 2);
					ctx.fillStyle = c.bg;
					ctx.fill();
					ctx.lineWidth = 1.25;
					ctx.strokeStyle = c.inkSoft;
					ctx.stroke();
					ctx.font = `500 ${numFont}px ${c.serif}`;
					ctx.fillStyle = c.ink;
					ctx.textAlign = 'center';
					ctx.textBaseline = 'middle';
					ctx.fillText(e.n, x, cy + 0.5);
				});
				ctx.restore();
			},
			afterDatasetsDraw(ch) {
				const { ctx, scales } = ch;
				ctx.save();
				ctx.font = `500 ${narrow ? 10 : 11}px ${c.serif}`;
				ctx.textAlign = 'right';

				ctx.fillStyle = c.teal;
				ctx.textBaseline = 'bottom';
				ctx.fillText(
					`$${LAST_DEBT[1].toFixed(1)}T`,
					scales.x.getPixelForValue(LAST_DEBT[0]) - 6,
					scales.yL.getPixelForValue(LAST_DEBT[1]) - 6,
				);

				ctx.fillStyle = c.warm;
				ctx.textBaseline = 'top';
				ctx.fillText(
					`${LAST_RATIO[1].toFixed(0)}%`,
					scales.x.getPixelForValue(LAST_RATIO[0]) - 4,
					scales.yR.getPixelForValue(LAST_RATIO[1]) + 8,
				);
				ctx.restore();
			},
		};

		const chart = new Chart(canvas, {
			type: 'line',
			data: {
				datasets: [
					{
						label: 'Total public debt',
						data: debt.map(([x, y]) => ({ x, y })),
						yAxisID: 'yL',
						borderColor: c.teal,
						borderWidth: 2.75,
						tension: 0.15,
						pointRadius: (ctx) => (ctx.dataIndex === debt.length - 1 ? 4.5 : 0),
						pointHitRadius: 6,
						pointBackgroundColor: c.teal,
						pointBorderColor: c.bg,
						pointBorderWidth: 2,
					},
					{
						label: 'Debt as % of GDP',
						data: ratio.map(([x, y]) => ({ x, y })),
						yAxisID: 'yR',
						borderColor: c.warm,
						borderWidth: 2,
						tension: 0.2,
						pointRadius: 0,
						pointHitRadius: 6,
					},
				],
			},
			options: {
				responsive: true,
				maintainAspectRatio: false,
				animation: false,
				// Top padding holds the president names; bumped after layout if the
				// event bubbles stagger deeper than one extra row.
				layout: { padding: { top: 18, right: 8 } },
				interaction: { mode: 'nearest', axis: 'x', intersect: false },
				plugins: {
					legend: { display: false },
					tooltip: {
						backgroundColor: c.tooltipBg,
						titleColor: c.ink,
						bodyColor: c.inkSoft,
						borderColor: c.rule,
						borderWidth: 1,
						titleFont: { family: c.serif },
						bodyFont: { family: c.serif },
						callbacks: {
							title: (items) => monthYear(items[0].parsed.x),
							label: (x) =>
								`${x.dataset.label}: ` +
								(x.dataset.yAxisID === 'yL'
									? `$${x.parsed.y.toFixed(2)}T`
									: `${x.parsed.y.toFixed(1)}%`),
						},
					},
				},
				scales: {
					yL: {
						position: 'left',
						min: 0,
						max: 44,
						title: {
							display: !narrow,
							text: 'Total public debt ($ trillion)',
							color: c.teal,
							font: { family: c.serif, size: 12 },
						},
						ticks: {
							stepSize: 10,
							color: c.inkSoft,
							font: { family: c.serif, size: narrow ? 10 : 11 },
							callback: (v) => `$${v}T`,
						},
						grid: { color: c.rule, drawTicks: false },
						border: { display: false },
					},
					yR: {
						position: 'right',
						min: 35,
						max: 155,
						title: {
							display: !narrow,
							text: 'Debt as % of GDP',
							color: c.warm,
							font: { family: c.serif, size: 12 },
						},
						ticks: {
							stepSize: 20,
							color: c.inkSoft,
							font: { family: c.serif, size: narrow ? 10 : 11 },
							callback: (v) => `${v}%`,
						},
						grid: { display: false },
						border: { display: false },
					},
					x: {
						type: 'linear',
						min: X_MIN,
						max: X_MAX,
						afterBuildTicks: (axis) => {
							const step = narrow ? 8 : 4;
							const years = [];
							for (let y = 1993; y <= 2025; y += step) years.push(y);
							axis.ticks = years.map((value) => ({ value }));
						},
						ticks: {
							color: c.inkSoft,
							font: { family: c.serif, size: narrow ? 10 : 11 },
							maxRotation: 0,
							callback: (v) => `${v}`,
						},
						grid: { display: false },
						border: { color: c.rule },
					},
				},
			},
			plugins: [overlay],
		});

		const { maxRow } = computeEventRows(chart);
		const neededTop = 18 + 19 * Math.max(0, maxRow - 1);
		if (neededTop !== chart.options.layout.padding.top) {
			chart.options.layout.padding.top = neededTop;
			chart.update('none');
		}
	}

	/*
	  The theme toggle writes data-theme during load, which can land mid-init and
	  race Chart.js. Debounce so we always settle on one build of the chart.
	*/
	let queued;
	function scheduleRender() {
		clearTimeout(queued);
		queued = setTimeout(() => {
			try {
				render();
			} catch (err) {
				console.error('[DebtChart] render failed', err);
			}
		}, 50);
	}

	if (document.readyState === 'loading') {
		document.addEventListener('DOMContentLoaded', scheduleRender);
	} else {
		scheduleRender();
	}
	onThemeChange(scheduleRender);
	window.matchMedia('(max-width: 560px)').addEventListener('change', scheduleRender);
</script>
