		['2025-10-15', 43.9, 52.8], ['2025-10-19', 44.2, 51.7], ['2025-10-23', 43.8, 52.3], ['2025-10-27', 43.8, 52.4],
		['2025-10-31', 43.6, 53], ['2025-11-04', 43, 53.9], ['2025-11-08', 42.8, 53.7], ['2025-11-12', 42.8, 53.7],
