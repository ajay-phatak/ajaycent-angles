---
// Trump approve / disapprove averages, May 2025 – Election Day 2026, with event markers.
---

<figure class="chart">
	<div class="chart-legend">
		<span><i class="swatch line-ink"></i>Approve</span>
		<span><i class="swatch line-warm"></i>Disapprove</span>
		<span><i class="swatch line-dash"></i>Key events</span>
	</div>

	<div class="chart-canvas">
		<canvas
			id="approval-timeline-chart"
			role="img"
			aria-label="Line chart of Donald Trump's approval and disapproval averages from May 2025 through Election Day, November 3, 2026. Approval starts near 46 percent and disapproval near 50 percent. By Election Day approval is 38.4 percent and disapproval 59.3 percent. Vertical markers show the shutdown beginning on October 1, 2025, the Minneapolis shootings on January 7, 2026, the Supreme Court striking down tariffs on February 20, the Iran war beginning on February 28, the ceasefire collapsing on July 8, and Election Day."
		>
			Trump's approval average fell from about 46 percent in May 2025 to 38.4 percent on
			Election Day 2026, while disapproval rose from about 50 percent to 59.3 percent.
		</canvas>
	</div>

	<ol class="event-key" aria-hidden="true">
		<li><b>1</b> Shutdown begins (Oct 1)</li>
		<li><b>2</b> Minneapolis shootings (Jan 7)</li>
		<li><b>3</b> Supreme Court strikes down tariffs (Feb 20)</li>
		<li><b>4</b> Iran war begins (Feb 28)</li>
		<li><b>5</b> Ceasefire collapses (Jul 8)</li>
		<li><b>6</b> Election Day (Nov 3)</li>
	</ol>

	<figcaption>
		Approval average: VoteHub, via the 2026 Election Tracker (elections.ajaycent.com), May
		2025 through Election Day.
	</figcaption>
</figure>

<style>
	.chart {
		margin: 2.5em 0;
		padding: 0;
	}
	.chart-legend {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5em 1.2em;
		margin-bottom: 0.9em;
		font-family: var(--font-serif);
		font-size: 0.78rem;
		color: var(--ink-soft);
	}
	.chart-legend span {
		display: flex;
		align-items: center;
		gap: 0.45em;
	}
	.swatch {
		display: inline-block;
		width: 18px;
		flex-shrink: 0;
	}
	.line-ink { height: 3px; background: var(--ink); }
	.line-warm { height: 3px; background: #b06135; }
	.line-dash { height: 0; border-top: 2px dashed var(--ink-soft); opacity: 0.7; }
	:global([data-theme='dark']) .line-warm { background: #d98f63; }
	@media (prefers-color-scheme: dark) {
		:global(:root:not([data-theme='light'])) .line-warm { background: #d98f63; }
	}

	.chart-canvas {
		position: relative;
		width: 100%;
		height: 420px;
	}
	.event-key {
		display: none;
		list-style: none;
		margin: 0.8em 0 0;
		padding: 0;
		font-family: var(--font-serif);
		font-size: 0.75rem;
		line-height: 1.6;
		color: var(--ink-soft);
	}
	.event-key b {
		display: inline-block;
		min-width: 1.4em;
		color: var(--ink);
	}
	figcaption {
		margin-top: 0.9em;
		font-family: var(--font-serif);
		font-size: 0.72rem;
		font-style: italic;
		line-height: 1.5;
		color: var(--ink-soft);
	}
	@media (max-width: 720px) {
		.chart-canvas { height: 380px; }
	}
	@media (max-width: 560px) {
		.chart-canvas { height: 360px; }
		.event-key { display: block; }
	}
</style>

<script>
	import Chart from 'chart.js/auto';
	import { palette, onThemeChange } from '../scripts/chart-theme.js';

	/* VoteHub averages via the 2026 Election Tracker: [date, approve %, disapprove %]. */
	const raw = [
