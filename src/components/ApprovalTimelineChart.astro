		['2025-06-25', 44.8, 52.2], ['2025-06-29', 44.8, 51.5], ['2025-07-03', 44.9, 51.5], ['2025-07-07', 44.9, 51.5],
		['2025-07-11', 45.3, 51.4], ['2025-07-15', 44.8, 52.1], ['2025-07-19', 44.6, 52.8], ['2025-07-23', 44.4, 52.7],
